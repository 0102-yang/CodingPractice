{
    "name": "LeetCode Cpp Development",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "features": {
        "ghcr.io/devcontainers/features/node:2.0.0": {
            "version": "lts"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "LeetCode.vscode-leetcode",
                "EditorConfig.EditorConfig",
                "ms-vscode.cpptools"
            ],
            "settings": {
                "leetcode.endpoint": "leetcode",
                "leetcode.defaultLanguage": "cpp",
                "leetcode.workspaceFolder": "/workspaces/CodingPractice/Solutions",
                "github.copilot.nextEditSuggestions.enabled": false,
                "github.copilot.nextEditSuggestions.fixes": false,
                "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
                "github.copilot.chat.codeGeneration.useInstructionFiles": false,
                "github.copilot.enable": {
                    "*": false,
                    "plaintext": false,
                    "markdown": false,
                    "scminput": false
                }
            }
        }
    },
    "postCreateCommand": "echo 'Dev container ready for LeetCode Cpp!'",
    "remoteUser": "vscode"
}
